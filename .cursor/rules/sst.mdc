#### Example 14: Working with Output Values in a Monorepo

**Task**: Effectively work with Output values across different modules in a monorepo.

**infra/outputs.ts**:
```typescript
import { StorageResources } from "./storage";
import { ApiResources } from "./api";

export interface OutputResources {
  apiConfig: sst.aws.Output<string>;
  storageConfig: sst.aws.Output<string>;
}

export async function setupOutputs(
  storage: StorageResources,
  api: ApiResources
): Promise<OutputResources> {
  // Use the $concat helper to work with Output values
  const assetUrlPrefix = $concat(storage.bucket.domain, "/assets");
  
  // Use the $interpolate helper for string interpolation with Output values
  const apiEndpoint = $interpolate`${api.url}/v1`;
  
  // Use $jsonStringify to create a stringified JSON config
  const apiConfig = $jsonStringify({
    endpoint: apiEndpoint,
    version: "1.0",
    timestamp: new Date().toISOString(),
  });
  
  // Use $jsonStringify to create a stringified JSON config
  const storageConfig = $jsonStringify({
    bucketName: storage.bucket.name,
    bucketDomain: storage.bucket.domain,
    assetUrlPrefix,
    region: "us-east-1",
  });
  
  // Create a function that can access this configuration
  const configFunction = new sst.aws.Function("ConfigFunction", {
    handler: "packages/functions/src/config/handler.handler",
    environment: {
      API_CONFIG: apiConfig,
      STORAGE_CONFIG: storageConfig,
    },
    url: true,
  });
  
  // Use $resolve to work with multiple outputs together
  const combinedConfig = $resolve([api.url, storage.bucket.name]).apply(
    ([apiUrl, bucketName]) => {
      // Here we can use actual values, not Output objects
      return {
        api: {
          url: apiUrl,
          version: "1.0",
        },
        storage: {
          bucket: bucketName,
          region: "us-east-1",
        },
        app: {
          name: "my-app",
          environment: process.env.STAGE || "dev",
        },
      };
    }
  );
  
  // Export for usage elsewhere in the codebase
  return {
    apiConfig,
    storageConfig,
  };
}
```

