#### Example 7: Authentication Setup in a Monorepo

**Task**: Set up authentication using Cognito in a monorepo.

**infra/auth.ts**:
```typescript
export interface AuthResources {
  auth: sst.aws.Auth;
  userPool: sst.aws.Output<string>;
  userPoolClientId: sst.aws.Output<string>;
}

export async function setupAuth(): Promise<AuthResources> {
  // Set up authentication
  const auth = new sst.aws.Auth("Auth", {
    login: ["email", "phone"],
    triggers: {
      preSignUp: "packages/functions/src/auth/pre-signup.handler",
      postConfirmation: "packages/functions/src/auth/post-confirmation.handler",
    },
    cdk: {
      userPool: {
        selfSignUpEnabled: true,
        autoVerify: { email: true, phone: true },
        passwordPolicy: {
          minLength: 8,
          requireLowercase: true,
          requireUppercase: true,
          requireDigits: true,
          requireSymbols: false,
        },
      },
    },
  });
  
  return {
    auth,
    userPool: auth.userPoolId,
    userPoolClientId: auth.userPoolClientId,
  };
}
```

**packages/functions/src/auth/pre-signup.ts**:
```typescript
import { PreSignUpTriggerHandler } from "aws-lambda";

export const handler: PreSignUpTriggerHandler = async (event) => {
  // Auto-confirm users for testing in development environments
  if (process.env.STAGE !== "production") {
    event.response.autoConfirmUser = true;
    
    // Auto-verify email and phone if provided
    if (event.request.userAttributes.email) {
      event.response.autoVerifyEmail = true;
    }
    
    if (event.request.userAttributes.phone_number) {
      event.response.autoVerifyPhone = true;
    }
  }
  
  // Additional custom validation logic could go here
  
  return event;
};
```

**packages/functions/src/auth/post-confirmation.ts**:
```typescript
import { PostConfirmationTriggerHandler } from "aws-lambda";
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, PutCommand } from "@aws-sdk/lib-dynamodb";
import { Resource } from "sst";

const ddbClient = new DynamoDBClient({});
const docClient = DynamoDBDocumentClient.from(ddbClient);

export const handler: PostConfirmationTriggerHandler = async (event) => {
  try {
    // After user confirms their account, create a record in Users table
    if (event.triggerSource === "PostConfirmation_ConfirmSignUp") {
      const { sub, email, phone_number } = event.request.userAttributes;
      
      await docClient.send(new PutCommand({
        TableName: Resource.UsersTable.name,
        Item: {
          userId: sub,
          email: email || null,
          phone: phone_number || null,
          status: "active",
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
        },
      }));
      
      console.log(`Created user record for ${sub}`);
    }
    
    return event;
  } catch (error) {
    console.error("Error creating user record:", error);
    // Don't fail the confirmation flow on error, just log it
    return event;
  }
};
```

**infra/index.ts** (updated to include auth):
```typescript
import { setupStorage } from "./storage";
import { setupAuth } from "./auth";
import { setupFunctions } from "./functions";
import { setupApi } from "./api";
