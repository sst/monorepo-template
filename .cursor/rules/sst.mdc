#### Example 6: Web Frontend in a Monorepo

**Task**: Set up a Next.js frontend in a monorepo structure with access to backend resources.

**Project Structure**:
```
my-sst-app/
├─ infra/
│  └─ web.ts         # Frontend infrastructure
├─ packages/
│  ├─ web/           # Next.js application
│  │  ├─ src/
│  │  │  └─ app/
│  │  ├─ next.config.js
│  │  └─ package.json
```

**infra/web.ts**:
```typescript
import { ApiResources } from "./api";
import { StorageResources } from "./storage";

export interface WebResources {
  url: sst.aws.Output<string>;
}

export async function setupWeb(
  api: ApiResources,
  storage: StorageResources
): Promise<WebResources> {
  // Create Next.js site
  const site = new sst.aws.Nextjs("Web", {
    path: "packages/web",
    link: [storage.bucket, api],
    domain: process.env.STAGE === "production" 
      ? {
          domainName: "myapp.com",
          hostedZone: "myapp.com",
        }
      : undefined,
    warm: process.env.STAGE === "production" ? 5 : 1,
    networking: {
      cdk: {
        distribution: {
          // Additional CloudFront configuration
          comment: "My App Frontend",
          priceClass: "PriceClass_100",
        }
      }
    }
  });
  
  return {
    url: site.url,
  };
}
```

