export function applyGlobalTransformations() {
  // Set defaults for all functions
  $transform(sst.aws.Function, (args, opts) => {
    // Set default runtime if not specified
    args.runtime ??= "nodejs18.x";
    
    // Set default memory if not specified
    args.memory ??= "256 MB";
    
    // Add default tags
    args.tags = {
      ...(args.tags || {}),
      ManagedBy: "SST",
      Environment: process.env.STAGE || "dev",
    };
    
    // Add default tracing
    args.tracing ??= "active";
  });
  
  // Set defaults for all buckets
  $transform(sst.aws.Bucket, (args, opts) => {
    // Enforce encryption by default
    args.cdk = {
      ...(args.cdk || {}),
      bucket: {
        ...(args.cdk?.bucket || {}),
        encryption: "AES256",
        blockPublicAccess: {
          blockPublicAcls: true,
          blockPublicPolicy: true,
          ignorePublicAcls: true,
          restrictPublicBuckets: true,
        },
      },
    };
  });
}
