        <li><span className="font-medium">Version:</span> {process.env.NEXT_PUBLIC_APP_VERSION || "development"}</li>
        <li><span className="font-medium">Build Date:</span> {process.env.NEXT_PUBLIC_BUILD_DATE || new Date().toISOString()}</li>
        {Resource.App.stage !== "prod" && (
          <li className="mt-2">
            <a 
              href={`https://console.sst.dev/app/${Resource.App.name}/${Resource.App.stage}`} 
              target="_blank" 
              rel="noopener noreferrer"
              className="text-blue-600 hover:text-blue-800 underline"
            >
              View in SST Console →
            </a>
          </li>
        )}
      </ul>
    </div>
  );
}
```

**scripts/deploy-pr.js**:
```javascript
#!/usr/bin/env node

// This script can be used for deploying PR previews from CI/CD
const { execSync } = require("child_process");
const { readFileSync, writeFileSync } = require("fs");
const path = require("path");

// Get PR number from environment variable
const prNumber = process.env.PR_NUMBER;
if (!prNumber) {
  console.error("PR_NUMBER environment variable is required");
  process.exit(1);
}

// Set up stage name for the PR
const stageName = `pr-${prNumber}`;

// Deploy using SST
console.log(`Deploying preview for PR #${prNumber} to stage ${stageName}...`);
try {
  // Build first
  execSync(`npm run build`, { stdio: "inherit" });
  
  // Deploy
  execSync(`npx sst deploy --stage ${stageName}`, { stdio: "inherit" });
  
  // Get deployed URL from SST outputs
  const output = execSync(`npx sst outputs --stage ${stageName} --json`).toString();
  const outputs = JSON.parse(output);
  
  // Log the deployed URL
  const webUrl = outputs.webUrl || "No web URL found in outputs";
  const apiUrl = outputs.apiUrl || "No API URL found in outputs";
  
  console.log(`\n✅ PR Preview deployed successfully!`);
  console.log(`📱 Frontend URL: ${webUrl}`);
  console.log(`🔌 API URL: ${apiUrl}`);
  console.log(`🔍 SST Console: https://console.sst.dev/preview/pr-${prNumber}`);
  
  // Create a comment file for GitHub Actions to post on the PR
  const commentFile = path.join(__dirname, "../pr-comment.md");
  const comment = `
## 🚀 PR Preview Deployed!

Your changes have been deployed to a preview environment:

- **Frontend:** @View Site
- **API:** \`${apiUrl}\`
- **SST Console:** @View Deployment

This preview will be automatically updated when you push new changes to this PR.
  `;
  
  writeFileSync(commentFile, comment);
  console.log(`\nComment file created at ${commentFile}`);
} catch (error) {
  console.error("Deployment failed:", error);
  process.exit(1);
}
```

**.github/workflows/preview.yml**:
```yaml
name: Deploy PR Preview

on:
  pull_request:
    types: [opened, synchronize, reopened]
    branches:
      - dev
      - main

jobs:
  deploy-preview:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Deploy PR preview
        run: node scripts/deploy-pr.js
        env:
          PR_NUMBER: ${{ github.event.pull_request.number }}
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          AWS_REGION: us-east-1
      
      - name: Comment on PR
        if: success()
        uses: actions/github-script@v6
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const commentBody = fs.readFileSync('./pr-comment.md', 'utf8');
            
            const { owner, repo, number } = context.issue;
            
            // Check if there's already a comment from the bot
            const comments = await github.rest.issues.listComments({
              owner,
              repo,
              issue_number: number,
            });
            
            const botComment = comments.data.find(comment => 
              comment.user.login === 'github-actions[bot]' && 
              comment.body.includes('PR Preview Deployed')
            );
            
            if (botComment) {
              // Update existing comment
              await github.rest.issues.updateComment({
                owner,
                repo,
                comment_id: botComment.id,
                body: commentBody,
              });
            } else {
              // Create new comment
              await github.rest.issues.createComment({
                owner,
                repo,
                issue_number: number,
                body: commentBody,
              });
            }
