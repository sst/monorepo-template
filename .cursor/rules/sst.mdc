#### Example 2: Creating Lambda Functions in a Monorepo

**Task**: Create serverless Lambda functions with proper organization in a monorepo.

**infra/functions.ts**:
```typescript
import { StorageResources } from "./storage";

export interface FunctionResources {
  api: sst.aws.Function;
  processor: sst.aws.Function;
}

export async function setupFunctions(storage: StorageResources): Promise<FunctionResources> {
  // API function with public access
  const api = new sst.aws.Function("ApiFunction", {
    handler: "packages/functions/src/api.handler",
    url: true,
    timeout: "5 minutes",
    memory: "1024 MB",
    link: [storage.bucket],
  });
  
  // Background processor function
  const processor = new sst.aws.Function("ProcessorFunction", {
    handler: "packages/functions/src/processor.handler",
    timeout: "10 minutes",
    memory: "2048 MB",
    link: [storage.bucket, storage.table],
  });
  
  return {
    api,
    processor
  };
}
```

**packages/functions/src/api.ts**:
```typescript
import { Resource } from "sst";

export async function handler(event) {
  // Access linked resources using the SST SDK
  console.log("Bucket name:", Resource.DataBucket.name);
  
  return {
    statusCode: 200,
    body: JSON.stringify({
      message: "API function executed successfully"
    })
  };
}
```

**Explanation**: In a monorepo structure, Lambda function infrastructure is defined in `./infra/functions.ts`, which exports a setup function and type interface. The actual function code lives in the `./packages/functions/` directory. This example shows how to create functions with different configurations and link them to resources from other modules. The `setupFunctions` function takes dependencies as parameters, establishing a clear dependency flow between resources.

