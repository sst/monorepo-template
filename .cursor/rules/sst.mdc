import { Resource } from "sst";
import { S3Client, PutObjectCommand } from "@aws-sdk/client-s3";
import { format } from "date-fns";
import { getDbPool } from "../db";

const s3 = new S3Client({});

export interface ReportConfig {
  type: "daily" | "weekly" | "monthly";
  startDate: Date;
  endDate: Date;
  format: "csv" | "json" | "pdf";
}

export async function generateReport(config: ReportConfig): Promise<string> {
  console.log(`Generating ${config.type} report from ${config.startDate.toISOString()} to ${config.endDate.toISOString()}`);
  
  // Query data from database based on report type and date range
  const pool = getDbPool();
  const data = await pool.query(`
    SELECT * FROM orders
    WHERE created_at BETWEEN $1 AND $2
    ORDER BY created_at DESC
  `, [config.startDate.toISOString(), config.endDate.toISOString()]);
  
  // Process and format the data based on report type
  let formattedData: string;
  
  if (config.format === "json") {
    formattedData = JSON.stringify(data.rows, null, 2);
  } else if (config.format === "csv") {
    formattedData = convertToCSV(data.rows);
  } else {
    throw new Error(`Unsupported format: ${config.format}`);
  }
  
  // Generate a unique filename
  const timestamp = format(new Date(), "yyyyMMdd-HHmmss");
  const filename = `${config.type}-report-${timestamp}.${config.format}`;
  
  // Upload to S3
  await s3.send(new PutObjectCommand({
    Bucket: Resource.ReportsBucket.name,
    Key: `reports/${config.type}/${filename}`,
    Body: formattedData,
    ContentType: config.format === "json" 
      ? "application/json" 
      : "text/csv",
  }));
  
  return filename;
}

function convertToCSV(data: any[]): string {
  if (data.length === 0) return "";
  
  // Get headers from first row
  const headers = Object.keys(data[0]);
  
  // Create CSV header row
  const csvRows = [headers.join(",")];
  
  // Add data rows
  for (const row of data) {
    const values = headers.map(header => {
      const value = row[header];
      return typeof value === "string" 
        ? `"${value.replace(/"/g, '""')}"` 
        : value;
    });
    csvRows.push(values.join(","));
  }
  
  return csvRows.join("\n");
}
```

