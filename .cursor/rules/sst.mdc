#### Example 15: Integrating with SST Console in a Monorepo

**Task**: Configure SST Console integration for deployment, monitoring, and preview environments in a monorepo.

**infra/console.ts**:
```typescript
export interface ConsoleConfig {
  enabled: boolean;
  previews: {
    enabled: boolean;
    pullRequests: {
      enabled: boolean;
      pattern?: string;
    };
    branches: {
      enabled: boolean;
      pattern?: string;
    };
  };
  monitoring: {
    enabled: boolean;
    errorThreshold: number;
  };
}

export function getConsoleConfig(stage: string): ConsoleConfig {
  // Base configuration
  const baseConfig: ConsoleConfig = {
    enabled: true,
    previews: {
      enabled: true,
      pullRequests: {
        enabled: true,
      },
      branches: {
        enabled: false,
      },
    },
    monitoring: {
      enabled: true,
      errorThreshold: 5, // 5% error rate threshold
    },
  };
  
  // Stage-specific configurations
  const stageConfigs: Record<string, Partial<ConsoleConfig>> = {
    dev: {
      previews: {
        pullRequests: {
          enabled: true,
          pattern: "pr-{id}.dev.myapp.com",
        },
      },
    },
    staging: {
      previews: {
        pullRequests: {
          enabled: true,
          pattern: "pr-{id}.staging.myapp.com",
        },
        branches: {
          enabled: true,
          pattern: "{branch}.staging.myapp.com",
        },
      },
    },
    prod: {
      // Disable previews in production
      previews: {
        enabled: false,
        pullRequests: {
          enabled: false,
        },
        branches: {
          enabled: false,
        },
      },
      // Stricter monitoring in production
      monitoring: {
        errorThreshold: 1, // 1% error rate threshold for production
      },
    },
  };
  
  // Filter out undefined values when merging
  const mergeObjects = (target: any, source: any) => {
    if (!source) return target;
    if (!target) return source;
    
    const result = { ...target };
    
    for (const key in source) {
      if (source[key] === null || source[key] === undefined) continue;
      
      if (typeof source[key] === 'object' && !Array.isArray(source[key])) {
        result[key] = mergeObjects(result[key], source[key]);
      } else {
        result[key] = source[key];
      }
    }
    
    return result;
  };
  
  // Merge base config with stage-specific config
  return mergeObjects(baseConfig, stageConfigs[stage] || {});
}
```

