#### Example 8: Database in a Monorepo with migrations

**Task**: Set up a PostgreSQL database with migrations in a monorepo.

**infra/database.ts**:
```typescript
import { StorageResources } from "./storage";

export interface DatabaseResources {
  postgres: sst.aws.Postgres;
  endpoint: sst.aws.Output<string>;
  secretArn: sst.aws.Output<string>;
}

export async function setupDatabase(
  storage: StorageResources
): Promise<DatabaseResources> {
  // Create VPC
  const vpc = new sst.aws.Vpc("AppNetwork", {
    bastion: true, // Include a bastion host for remote access
  });
  
  // Create PostgreSQL database
  const postgres = new sst.aws.Postgres("Database", {
    vpc,
    scaling: {
      minCapacity: "1 ACU",
      maxCapacity: "4 ACU",
    },
    migrations: {
      path: "packages/core/migrations",
    },
    defaultDatabaseName: "myapp",
  });
  
  // Create a function to run database migrations
  const migrationFunction = new sst.aws.Function("MigrationRunner", {
    handler: "packages/functions/src/db/run-migrations.handler",
    link: [postgres],
    nodejs: {
      install: ["pg", "node-pg-migrate"],
    },
    timeout: "5 minutes",
    environment: {
      MIGRATIONS_PATH: "migrations",
    },
  });
  
  // Create a bucket event notification to trigger migrations on file changes
  storage.schemasBucket.notify("MigrationTrigger", {
    function: migrationFunction,
    events: ["object_created", "object_removed"],
    filters: [{ prefix: "migrations/" }],
  });
  
  return {
    postgres,
    endpoint: postgres.endpoint,
    secretArn: postgres.secretArn,
  };
}
