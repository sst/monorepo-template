export interface FunctionResources {
  api: sst.aws.Function;
  worker: sst.aws.Function;
}

export async function setupFunctions(
  storage: StorageResources,
  database: DatabaseResources
): Promise<FunctionResources> {
  // API function with specific transformations
  const api = new sst.aws.Function("ApiFunction", {
    handler: "packages/functions/src/api/handler.handler",
    url: true,
    // Apply specific transformations
    transform: {
      // Customize the IAM role
      role: (args) => {
        args.name = `${args.name}-ApiRole`;
        args.managedPolicies = [
          ...(args.managedPolicies || []),
          { name: "AmazonSESFullAccess" },
        ];
        args.inlinePolicies = {
          ...(args.inlinePolicies || {}),
          ApiCustomPolicy: JSON.stringify({
            Version: "2012-10-17",
            Statement: [
              {
                Effect: "Allow",
                Action: [
                  "dynamodb:BatchGetItem",
                  "dynamodb:GetItem",
                  "dynamodb:Query",
                  "dynamodb:Scan",
                ],
                Resource: "*",
              },
            ],
          }),
        };
      },
      // Customize the Lambda function
      function: (args) => {
        args.description = "API function handling HTTP requests";
        args.reservedConcurrentExecutions = 20;
        args.environment = {
          ...(args.environment || {}),
          API_VERSION: "1.0",
        };
      },
      // Customize the log group
      logGroup: (args) => {
        args.retentionInDays = 30;
      },
    },
  });
  
  // Worker function with different transformations
  const worker = new sst.aws.Function("WorkerFunction", {
    handler: "packages/functions/src/worker/handler.handler",
    timeout: "5 minutes",
    memory: "2048 MB",
    transform: {
      function: (args) => {
