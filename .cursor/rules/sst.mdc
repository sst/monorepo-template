export interface StageConfig {
  name: string;
  domain?: string;
  removal: "remove" | "retain";
  env: Record<string, string>;
  vpc: {
    enabled: boolean;
    natGateways: number;
  };
  scaling: {
    min: number;
    max: number;
  };
}

export function getStageConfig(stageName: string): StageConfig {
  const defaultConfig: StageConfig = {
    name: stageName,
    removal: "remove",
    env: {
      NODE_ENV: "development",
    },
    vpc: {
      enabled: false,
      natGateways: 0,
    },
    scaling: {
      min: 1,
      max: 1,
    },
  };
  
  // Stage-specific configurations
  const stageConfigs: Record<string, Partial<StageConfig>> = {
    dev: {
      env: {
        NODE_ENV: "development",
        LOG_LEVEL: "debug",
      },
      scaling: {
        min: 1,
        max: 1,
      },
    },
    staging: {
      domain: "staging.myapp.com",
      env: {
        NODE_ENV: "staging",
        LOG_LEVEL: "info",
      },
      vpc: {
        enabled: true,
        natGateways: 1,
      },
      scaling: {
        min: 1,
        max: 2,
      },
    },
    prod: {
      domain: "myapp.com",
      removal: "retain",
      env: {
        NODE_ENV: "production",
        LOG_LEVEL: "warn",
      },
      vpc: {
        enabled: true,
        natGateways: 3,
      },
      scaling: {
        min: 2,
        max: 10,
      },
    },
  };
  
  // Merge default config with stage-specific config
  return {
    ...defaultConfig,
    ...stageConfigs[stageName] || {},
  };
}
