**packages/functions/src/db/run-migrations.ts**:
```typescript
import { S3Event } from "aws-lambda";
import { Resource } from "sst";
import path from "path";
import fs from "fs";
import os from "os";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { exec } from "child_process";
import { promisify } from "util";

const execAsync = promisify(exec);
const s3 = new S3Client({});

export async function handler(event: S3Event) {
  console.log("Migration event triggered:", JSON.stringify(event, null, 2));
  
  try {
    // Create temp directory for migrations
    const tempDir = path.join(os.tmpdir(), 'migrations-' + Date.now());
    fs.mkdirSync(tempDir, { recursive: true });
    
    // Download migration files from S3
    for (const record of event.Records) {
      const bucketName = record.s3.bucket.name;
      const key = decodeURIComponent(record.s3.object.key.replace(/\+/g, ' '));
      
      if (key.endsWith('.js') && key.startsWith('migrations/')) {
        const fileName = path.basename(key);
        const filePath = path.join(tempDir, fileName);
        
        const command = new GetObjectCommand({
          Bucket: bucketName,
          Key: key,
        });
        
        const response = await s3.send(command);
        const fileContent = await response.Body.transformToString();
        fs.writeFileSync(filePath, fileContent);
        
        console.log(`Downloaded migration file: ${fileName}`);
      }
    }
    
    // Run migrations using node-pg-migrate
    const dbUrl = `postgres://${Resource.Database.username}:${Resource.Database.password}@${Resource.Database.endpoint}/${Resource.Database.database}`;
    
    const { stdout, stderr } = await execAsync(
      `npx node-pg-migrate up --migration-file-language js --migrations-dir ${tempDir}`,
      {
        env: {
          ...process.env,
          DATABASE_URL: dbUrl,
        },
      }
    );
    
    console.log('Migration stdout:', stdout);
    
    if (stderr) {
      console.error('Migration stderr:', stderr);
    }
    
    return {
      statusCode: 200,
      body: JSON.stringify({ message: 'Migrations completed successfully' }),
    };
  } catch (error) {
    console.error('Error running migrations:', error);
    throw error;
  }
}
```

