#### Example 4: Resource Linking in a Monorepo

**Task**: Link resources across different modules in a monorepo.

**infra/index.ts**:
```typescript
import { setupStorage } from "./storage";
import { setupFunctions } from "./functions";
import { setupWeb } from "./web";
import { setupApi } from "./api";

export async function run() {
  // Create resources in the correct dependency order
  const storage = await setupStorage();
  const functions = await setupFunctions(storage);
  const api = await setupApi(functions, storage);
  const web = await setupWeb(api, storage);
  
  return {
    apiUrl: api.url,
    webUrl: web.url,
    bucketName: storage.bucket.name,
  };
}
```

**infra/api.ts**:
```typescript
import { StorageResources } from "./storage";
import { FunctionResources } from "./functions";

export interface ApiResources {
  url: sst.aws.Output<string>;
}

export async function setupApi(
  functions: FunctionResources, 
  storage: StorageResources
): Promise<ApiResources> {
  // Create API Gateway using functions created in functions.ts
  const api = new sst.aws.Router("Api", {
    routes: {
      "GET /users": functions.api,
      "POST /process": functions.processor,
    },
  });
  
  return {
    url: api.url,
  };
}
```

**packages/functions/src/processor.ts**:
```typescript
import { Resource } from "sst";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";

const s3 = new S3Client({});

export async function handler(event) {
  // Access the linked bucket using the SST SDK
  const bucketName = Resource.DataBucket.name;
  
  // Process data from the bucket
  const command = new GetObjectCommand({
    Bucket: bucketName,
    Key: "data.json",
  });
  
  try {
    const response = await s3.send(command);
    const data = JSON.parse(await response.Body.transformToString());
    
    // Process data...
    
    return {
      statusCode: 200,
      body: JSON.stringify({ success: true }),
    };
  } catch (error) {
    return {
      statusCode: 500,
      body: JSON.stringify({ error: error.message }),
    };
  }
}
```

**Explanation**: This example shows how resource linking works in a monorepo structure. Resources are created in separate module files and passed as parameters to dependent modules, establishing a clear flow of dependencies. The `setupApi` function takes both functions and storage resources as parameters to configure routes. Lambda functions in `./packages/functions/` can access linked resources using the SST SDK's `Resource` object, providing typesafe access to infrastructure resources.

