    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "typescript": "^5.0.0"
  }
}
```

**packages/functions/src/api.ts**:
```typescript
import { APIGatewayProxyHandlerV2 } from "aws-lambda";
import { Resource } from "sst";
import { ApiResponse, FileMetadata } from "@my-app/core";
import { getPresignedPutUrl, generateFileMetadata } from "@my-app/core";
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, PutCommand } from "@aws-sdk/lib-dynamodb";

const ddbClient = new DynamoDBClient({});
const docClient = DynamoDBDocumentClient.from(ddbClient);

export const handler: APIGatewayProxyHandlerV2 = async (event) => {
  try {
    // Parse request body
    const body = JSON.parse(event.body || "{}");
    const { filename, contentType, size } = body;
    const userId = event.requestContext.authorizer?.jwt.claims.sub || "anonymous";
    
    // Generate unique file key
    const key = `${userId}/${Date.now()}-${filename}`;
    
    // Generate pre-signed URL for file upload
    const uploadUrl = await getPresignedPutUrl(key, contentType);
    
    // Create file metadata
    const metadata = generateFileMetadata(key, contentType, size, userId);
    
    // Store metadata in DynamoDB
    await docClient.send(new PutCommand({
      TableName: Resource.FilesTable.name,
      Item: metadata,
    }));
    
    const response: ApiResponse<{ uploadUrl: string; metadata: FileMetadata }> = {
      success: true,
      data: {
        uploadUrl,
        metadata,
      },
    };
    
    return {
      statusCode: 200,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(response),
    };
  } catch (error) {
    console.error("Error generating upload URL:", error);
    
    const response: ApiResponse<never> = {
      success: false,
      error: error.message,
    };
    
    return {
      statusCode: 500,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(response),
    };
  }
};
```

**Explanation**: This example demonstrates how to create and use shared code in a monorepo. The `@my-app/core` package contains shared types, utilities, and functions that can be imported by other packages. The functions package imports from the core package using the workspace dependency (`"@my-app/core": "*"`). This structure promotes code reuse and keeps the codebase DRY. When linked resources are accessed in utilities, they're available to all functions that import those utilities.

