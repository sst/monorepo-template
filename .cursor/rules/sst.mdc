#### Example 9: Event-Driven Architecture in a Monorepo

**Task**: Implement a queue-based event system with producers and consumers in a monorepo.

**infra/queues.ts**:
```typescript
import { StorageResources } from "./storage";

export interface QueueResources {
  orderQueue: sst.aws.Queue;
  paymentQueue: sst.aws.Queue;
  dlq: sst.aws.Queue;
}

export async function setupQueues(storage: StorageResources): Promise<QueueResources> {
  // Dead-letter queue for failed messages
  const dlq = new sst.aws.Queue("DeadLetterQueue");
  
  // Order processing queue
  const orderQueue = new sst.aws.Queue("OrderQueue", {
    fifo: true,  // First-in, first-out queue
    consumer: {
      function: "packages/functions/src/consumers/process-order.handler",
      cdk: {
        eventSource: {
          batchSize: 10,
          maxBatchingWindow: "1 minute",
          reportBatchItemFailures: true,  // Enable partial batch failures
        },
      },
    },
    deadLetterQueue: dlq,
  });
  
  // Payment processing queue
  const paymentQueue = new sst.aws.Queue("PaymentQueue", {
    consumer: {
      function: "packages/functions/src/consumers/process-payment.handler",
    },
    deadLetterQueue: dlq,
  });
  
  // Create notification handlers for successful and failed processing
  dlq.subscribe("FailedOrderHandler", "packages/functions/src/consumers/failed-order.handler");
  
  // Subscribe to storage events and publish to queues
  storage.bucket.notify("NewOrderTrigger", {
    function: {
      handler: "packages/functions/src/producers/order-file-processor.handler",
      link: [orderQueue],
    },
    events: ["object_created"],
    filters: [{ prefix: "orders/" }],
  });
  
  return {
    orderQueue,
    paymentQueue,
    dlq,
  };
}
```

