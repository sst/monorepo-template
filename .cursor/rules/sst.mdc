```typescript
import { S3Event } from "aws-lambda";
import { Resource } from "sst";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { SQSClient, SendMessageCommand } from "@aws-sdk/client-sqs";
import { OrderCreatedEvent } from "@my-app/core/src/events/order-events";

const s3 = new S3Client({});
const sqs = new SQSClient({});

export async function handler(event: S3Event) {
  for (const record of event.Records) {
    try {
      const bucket = record.s3.bucket.name;
      const key = decodeURIComponent(record.s3.object.key.replace(/\+/g, ' '));
      
      console.log(`Processing new order file: ${key}`);
      
      // Get the order file from S3
      const command = new GetObjectCommand({
        Bucket: bucket,
        Key: key,
      });
      
      const response = await s3.send(command);
      const orderData = await response.Body.transformToString();
      const order = JSON.parse(orderData);
      
      // Create an order event
      const orderEvent: OrderCreatedEvent = {
        eventType: "ORDER_CREATED",
        orderId: order.id,
        userId: order.userId,
        products: order.items.map(item => ({
          productId: item.productId,
          quantity: item.quantity,
          price: item.price,
        })),
        totalAmount: order.totalAmount,
        shippingAddress: order.shippingAddress,
        timestamp: new Date().toISOString(),
      };
      
      // Send to the order queue
      await sqs.send(new SendMessageCommand({
        QueueUrl: Resource.OrderQueue.url,
        MessageBody: JSON.stringify(orderEvent),
        MessageGroupId: order.userId, // Group by user ID for FIFO queue
        MessageDeduplicationId: `order-${order.id}-${Date.now()}`, // Unique deduplication ID
      }));
      
      console.log(`Order event sent to queue for order ${order.id}`);
    } catch (error) {
      console.error("Error processing order file:", error);
      throw error;
    }
  }
}
```

