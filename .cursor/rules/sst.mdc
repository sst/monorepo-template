```typescript
import { SQSEvent, SQSBatchResponse } from "aws-lambda";
import { Resource } from "sst";
import { SQSClient, SendMessageCommand } from "@aws-sdk/client-sqs";
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, PutCommand } from "@aws-sdk/lib-dynamodb";
import { 
  OrderCreatedEvent, 
  OrderProcessedEvent,
  PaymentRequestedEvent 
} from "@my-app/core/src/events/order-events";

const sqs = new SQSClient({});
const ddbClient = new DynamoDBClient({});
const docClient = DynamoDBDocumentClient.from(ddbClient);

export async function handler(event: SQSEvent): Promise<SQSBatchResponse> {
  const batchItemFailures: { itemIdentifier: string }[] = [];
  
  for (const record of event.Records) {
    try {
      const body = JSON.parse(record.body) as OrderCreatedEvent;
      
      if (body.eventType !== "ORDER_CREATED") {
        console.log(`Skipping non-ORDER_CREATED event: ${body.eventType}`);
        continue;
      }
      
      // Store order in database
      await docClient.send(new PutCommand({
        TableName: Resource.OrdersTable.name,
        Item: {
          orderId: body.orderId,
          userId: body.userId,
          products: body.products,
          totalAmount: body.totalAmount,
          shippingAddress: body.shippingAddress,
          status: "PROCESSING",
          createdAt: body.timestamp,
          updatedAt: new Date().toISOString(),
        },
      }));
      
      // Generate a payment request event
      const paymentEvent: PaymentRequestedEvent = {
        eventType: "PAYMENT_REQUESTED",
        orderId: body.orderId,
        userId: body.userId,
        amount: body.totalAmount,
        timestamp: new Date().toISOString(),
      };
      
      // Send to payment queue
      await sqs.send(new SendMessageCommand({
        QueueUrl: Resource.PaymentQueue.url,
        MessageBody: JSON.stringify(paymentEvent),
      }));
      
      // Mark the order as processed
      const processedEvent: OrderProcessedEvent = {
        eventType: "ORDER_PROCESSED",
        orderId: body.orderId,
        status: "PROCESSED",
        processedAt: new Date().toISOString(),
      };
      
      console.log(`Order ${body.orderId} processed successfully`);
    } catch (error) {
      console.error(`Error processing order from record ${record.messageId}:`, error);
      batchItemFailures.push({ itemIdentifier: record.messageId });
    }
  }
  
  return { batchItemFailures };
}
```

**Explanation**: This example demonstrates how to implement an event-driven architecture in a monorepo using SQS queues. The infrastructure code in `./infra/queues.ts` sets up multiple queues with different configurations, including a FIFO queue for orders, a standard queue for payments, and a dead-letter queue for failed messages. Event types are defined in the core package, making them available to all services. The producer and consumer functions are organized in separate directories with appropriate naming. The example shows how to configure batch processing, handle partial failures, and chain events together to build a complete workflow.

