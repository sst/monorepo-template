```tsx
"use client";

import React, { useState } from "react";
import { Resource } from "sst";

export default function UploadsPage() {
  const [file, setFile] = useState<File | null>(null);
  const [uploading, setUploading] = useState(false);
  const [uploadUrl, setUploadUrl] = useState("");
  
  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files[0]) {
      setFile(e.target.files[0]);
    }
  };
  
  const getUploadUrl = async () => {
    if (!file) return;
    
    setUploading(true);
    try {
      // Use the API to get a pre-signed URL
      const response = await fetch(`${Resource.Api.url}/upload`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          filename: file.name,
          contentType: file.type,
          size: file.size,
        }),
      });
      
      const data = await response.json();
      
      if (data.success) {
        setUploadUrl(data.data.uploadUrl);
        await uploadToS3(data.data.uploadUrl);
      }
    } catch (error) {
      console.error("Error getting upload URL:", error);
    } finally {
      setUploading(false);
    }
  };
  
  const uploadToS3 = async (url: string) => {
    if (!file) return;
    
    try {
      await fetch(url, {
        method: "PUT",
        body: file,
        headers: {
          "Content-Type": file.type,
        },
      });
      
      alert("File uploaded successfully!");
    } catch (error) {
      console.error("Error uploading file:", error);
    }
  };
  
  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold mb-4">File Upload</h1>
      <div className="mb-4">
        <input 
          type="file" 
          onChange={handleFileChange}
          className="border p-2 rounded"
        />
      </div>
      {file && (
        <button
          onClick={getUploadUrl}
          disabled={uploading}
          className="bg-blue-500 text-white px-4 py-2 rounded disabled:bg-gray-400"
        >
          {uploading ? "Uploading..." : "Upload File"}
        </button>
      )}
    </div>
  );
}
```

**Explanation**: This example demonstrates how to set up a Next.js frontend in a monorepo structure. The infrastructure code in `./infra/web.ts` defines the Next.js site with production and development configurations. The frontend code in `./packages/web/` includes a server route and client page that access linked resources using the SST SDK. Note the `sst bind next dev` script in package.json, which ensures the development server has access to linked resources.

